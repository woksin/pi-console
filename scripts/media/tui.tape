# Regenerate with: npm run media -- --only=tui-vhs
# The runner supplies an isolated real demo daemon. The token is read from a file,
# never typed into this recording or printed to the terminal.
Output .ai-work/media-work/tui-vhs.gif
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 14
Set Width 1100
Set Height 688
Set Framerate 12
Set TypingSpeed 80ms
Set Padding 8
Set Theme "Catppuccin Mocha"
Hide
Type "node --experimental-ffi --disable-warning=ExperimentalWarning scripts/media/vhs-tui.mjs"
Enter
Sleep 4s
Show
Sleep 2s
Type "2"
Sleep 2s
Type "3"
Sleep 2s
Type ":"
Sleep 500ms
Type "settings"
Sleep 1s
Enter
Sleep 2s
Hide
Ctrl+C
Sleep 500ms
