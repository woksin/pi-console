    "@cratis/arc.hono": "1.0.0",
    "@cratis/arc.react": "22.45.0",
    "@cratis/fundamentals": "7.19.6",
    "@hono/node-server": "1.19.19",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@cratis/arc.proxygenerator": "1.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
