  },
  "dependencies": {
    "@pi-console/contract": "*",
    "@pi-console/viewmodels": "*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "playwright-core": "1.65.1",
    "vite": "8.3.8",
    "@pi-console/testkit": "*"
  }
}
