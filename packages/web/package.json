{
  "name": "@pi-console/web",
  "version": "0.0.0",
  "private": true,
  "description": "React web client for observing pi agent fleets and requesting opt-in memory review.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woksin/pi-console.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/woksin/pi-console",
  "keywords": ["pi", "ai-agents", "observability", "web", "react", "memory-review"],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "TZ=UTC node --test \"src/**/*.test.ts\"",
    "build": "vite build --config vite/vite.config.ts",
    "build:check": "tsc -b . && tsc -p e2e && tsc -p vite && vite build --config vite/vite.config.ts",
    "serve": "node src/server/serve.ts",
    "e2e": "node --test --test-concurrency=1 --test-timeout=120000 e2e/console.e2e.ts e2e/transcript.e2e.ts e2e/ux.e2e.ts e2e/a11y.e2e.ts e2e/web-a11y.e2e.ts",
    "screenshots": "node e2e/screenshots.ts"
  },
  "dependencies": {
    "@pi-console/contract": "*",
    "@pi-console/viewmodels": "*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "playwright-core": "1.65.1",
    "vite": "8.3.8",
    "@pi-console/testkit": "*"
  }
}
