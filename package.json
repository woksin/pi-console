{
  "name": "pi-console",
  "private": true,
  "description": "Read-only observability console for pi agent fleets, with web and terminal UIs and opt-in memory review requests.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woksin/pi-console.git"
  },
  "homepage": "https://github.com/woksin/pi-console",
  "keywords": ["pi", "ai-agents", "observability", "web", "tui", "memory-review"],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "node packages/testkit/src/fixture/generate.ts",
    "start": "node packages/testkit/src/mock-daemon/server.ts",
    "check": "node spikes/mock-daemon/check.ts",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "gate": "node scripts/gate.mjs",
    "gate:integration": "node scripts/gate-integration.mjs",
    "console": "node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "media": "node scripts/media/index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
