{
  "name": "pi-console",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "node packages/testkit/src/fixture/generate.ts",
    "start": "node packages/testkit/src/mock-daemon/server.ts",
    "check": "node spikes/mock-daemon/check.ts",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "gate": "node scripts/gate.mjs",
    "gate:integration": "node scripts/gate-integration.mjs",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "media": "node scripts/media/index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
