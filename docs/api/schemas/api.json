{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-console.invalid/api/v0/schemas/api.json",
  "$defs": {
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "laneId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "orchestrator",
            "main",
            "subagent"
          ]
        },
        "parentSessionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "orchestratorSessionId": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "working",
            "needs-you",
            "blocked",
            "waiting",
            "idle",
            "done",
            "failed"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "contextPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "contextPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              },
              "costUsd": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "at",
              "contextPercent",
              "tokens",
              "costUsd"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "repositoryId",
        "name",
        "laneId",
        "role",
        "parentSessionId",
        "orchestratorSessionId",
        "branch",
        "cwd",
        "model",
        "status",
        "startedAt",
        "updatedAt",
        "contextPercent",
        "samples"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "human",
            "launch",
            "unproven"
          ]
        },
        "originLabel": {
          "type": "string",
          "enum": [
            "Human request",
            "Initial prompt",
            "Unproven origin"
          ]
        },
        "originEvidence": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "answered",
            "unanswered",
            "interrupted"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "resetId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "answer": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "interim": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "text",
                "at",
                "interim"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "interimAnswers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "interim": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "text",
              "at",
              "interim"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "sessionId",
        "text",
        "origin",
        "originLabel",
        "originEvidence",
        "status",
        "createdAt",
        "resetId",
        "answer",
        "interimAnswers"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "question",
            "decision",
            "approval",
            "fyi"
          ]
        },
        "text": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "urgency": {
          "type": "string",
          "enum": [
            "normal",
            "high"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "answered",
            "deferred",
            "closed"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "sessionId",
        "kind",
        "text",
        "options",
        "urgency",
        "blocking",
        "status",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fromSessionId": {
          "type": "string",
          "minLength": 1
        },
        "toSessionId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "sent",
            "delivered",
            "read"
          ]
        },
        "sentAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "fromSessionId",
        "toSessionId",
        "text",
        "status",
        "sentAt"
      ],
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "job",
            "phase",
            "ci"
          ]
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "queued",
            "done",
            "failed"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "sessionId",
        "kind",
        "name",
        "status",
        "startedAt",
        "exitCode"
      ],
      "additionalProperties": false
    },
    "reset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "handoff",
            "compaction",
            "relaunch"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "carriedRequestIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interruptedRequestIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "sessionId",
        "kind",
        "at",
        "carriedRequestIds",
        "interruptedRequestIds"
      ],
      "additionalProperties": false
    },
    "transcriptEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "enum": [
            "user",
            "thinking",
            "assistant.delta",
            "assistant",
            "tool.call",
            "tool.result",
            "diff",
            "reset"
          ]
        },
        "text": {
          "type": "string"
        },
        "toolCallId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resetId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "cursor",
        "sessionId",
        "at",
        "kind",
        "text",
        "toolCallId",
        "resetId"
      ],
      "additionalProperties": false
    },
    "interventionInput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "answer",
            "steer",
            "followUp",
            "nextTurn",
            "abort"
          ]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "confirmation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "intervention": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "answer",
            "steer",
            "followUp",
            "nextTurn",
            "abort"
          ]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "questionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "confirmation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "const": "user:dev"
        },
        "tokenId": {
          "const": "dev"
        },
        "origin": {
          "type": "string"
        },
        "result": {
          "const": "mock-only"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "sessionId",
        "questionId",
        "text",
        "confirmation",
        "actor",
        "tokenId",
        "origin",
        "result",
        "recordedAt"
      ],
      "additionalProperties": false
    },
    "overview": {
      "type": "object",
      "properties": {
        "counts": {
          "type": "object",
          "properties": {
            "sessions": {
              "type": "integer",
              "minimum": 0
            },
            "repositories": {
              "type": "integer",
              "minimum": 0
            },
            "byStatus": {
              "type": "object",
              "properties": {
                "working": {
                  "type": "integer",
                  "minimum": 0
                },
                "needs-you": {
                  "type": "integer",
                  "minimum": 0
                },
                "blocked": {
                  "type": "integer",
                  "minimum": 0
                },
                "waiting": {
                  "type": "integer",
                  "minimum": 0
                },
                "idle": {
                  "type": "integer",
                  "minimum": 0
                },
                "done": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "working",
                "needs-you",
                "blocked",
                "waiting",
                "idle",
                "done",
                "failed"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "sessions",
            "repositories",
            "byStatus"
          ],
          "additionalProperties": false
        },
        "needsYou": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "request",
                  "question"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "sessionId",
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "sparkline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "contextPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              },
              "costUsd": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "at",
              "contextPercent",
              "tokens",
              "costUsd"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "counts",
        "needsYou",
        "sparkline"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "version": {
          "const": 0
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/request"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/job"
          }
        },
        "resets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reset"
          }
        },
        "transcriptCursors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "cursor": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "sessionId",
              "cursor"
            ],
            "additionalProperties": false
          }
        },
        "interventions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intervention"
          }
        }
      },
      "required": [
        "version",
        "generatedAt",
        "repositories",
        "sessions",
        "requests",
        "questions",
        "messages",
        "jobs",
        "resets",
        "transcriptCursors",
        "interventions"
      ],
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "requests": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/request"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "questions": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "messages": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "jobs": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "sessionDetail": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/$defs/session"
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/request"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/job"
          }
        },
        "resets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reset"
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          }
        }
      },
      "required": [
        "session",
        "requests",
        "questions",
        "jobs",
        "resets",
        "subagents"
      ],
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transcriptEntry"
          }
        },
        "nextCursor": {
          "type": "integer",
          "minimum": 0
        },
        "hasMore": {
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "nextCursor",
        "hasMore"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "const": "snapshot"
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "$ref": "#/$defs/snapshot"
            }
          },
          "required": [
            "seq",
            "type",
            "occurredAt",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "const": "session.updated"
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "$ref": "#/$defs/session"
            }
          },
          "required": [
            "seq",
            "type",
            "occurredAt",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "const": "transcript.appended"
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "$ref": "#/$defs/transcriptEntry"
            }
          },
          "required": [
            "seq",
            "type",
            "occurredAt",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "const": "request.observed"
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "$ref": "#/$defs/request"
            }
          },
          "required": [
            "seq",
            "type",
            "occurredAt",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "const": "request.interrupted"
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "$ref": "#/$defs/request"
            }
          },
          "required": [
            "seq",
            "type",
            "occurredAt",
            "payload"
          ],
          "additionalProperties": false
        },
        {
